<section class="bg-light section-feedback py4">
  <div class="container-md">
    <div class="text-center px1m mt2 mb4">
      <div class="container flex align-items-center justify-content-center gap2 mobile-column mx-auto">
        <a class="btn btn--big btn--red" href="#sign-petition">Jetzt unterschreiben</a>
        <a class="btn btn--big ext" href="https://support.epicenter.works/join?amount=25" target="_blank">Jetzt Fördermitglied werden</a>
      </div>
      <h2 class="uppercase text-center text-purple mt4">
        Aktuelle Begutachtung
      </h2>
      <p class="text-lg mb2">Die neue ÖVP-SPÖ-NEOS Regierung plant den Bundestrojaner einzuführen! Das ist der fünfte Versuch eine staatliche Spionagesoftware in Österreich zu legalisieren. Wenn du gegen diese Massengefährdung von unseren Smartphones bist und Verschlüsselung erhalten willst, dann gib bis zum 3. Juni 2025 eine Stellungnahme auf der Parlamentswebsite ab. Jede Stimme zählt!</p>
      <a class="btn ext" href="https://www.parlament.gv.at/gegenstand/XXVIII/ME/8?selectedStage=101" target="_blank">Stellungnahmen ansehen</a>
    </div>
    <h2 class="uppercase text-center text-purple mb2">
      Bisherige Stellungnahmen
    </h2>
    <!-- Slider main container -->
    <div class="swiper swiper-feedback shadow">
      <!-- Additional required wrapper -->
      <div class="swiper-wrapper">
        <!-- Slides -->
        {% for item in collections.feedback %}
          {% if item.data.featured %}
            <div class="swiper-slide">
              <div class="feedback-slide flex align-items-center justify-content-center">
                <div class="feedback-slide__inner" style="align-self: center;">
                  <div class="flex gap1 align-items-center justify-content-center mobile-column mb1 mx-auto">
                    {% if item.data.logo %}
                      <img class="feedback-logo" src="/static/img/logos/{{ item.data.logo }}" width="200" height="50" alt="{{ item.data.author }} logo">
                    {% endif %}
                    <p class="bold m0">{{ item.data.author }}</p>
                  </div>
                  <blockquote>
                    {{ item.templateContent | safe }}
                  </blockquote>
                  <p class="text-center text-sm mt1 mb0">
                    Stellungnahme vom <time datetime="{{ item.date | date('YYYY-MM-DD') }}">{{ item.date | date('DD.MM.YYYY') }}</time> | <a class="ext" href="{{ item.data.source }}">Quelle</a>
                  </p>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <!-- Swiper pagination -->
      {# <div class="swiper-pagination"></div> #}
      <!-- Swiper navigation buttons -->
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
    <div class="mt2">
      <p class="text-center m0">
        <a class="btn" href="#stellungnahmen">Alle Stellungnahmen</a>
      </p>
    </div>
  </div>
</section>
