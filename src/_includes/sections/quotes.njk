<section id="zitate" class="section-quotes">
  <div class="container flex flex-column align-items-center justify-content-center gap4">
    <div class="section-quotes__image mx-auto">
      <img class="block drop-shadow mx-auto" src="/img/quotes.svg" alt="quotes illustration" width="200">
      <h2 class="text-light uppercase text-center px1m mt1 mb2">
        Was sagt die Politik?
      </h2>
    </div>
  </div>
</section>
<section class="bg-purple py4">
  <div class="container-md pb4 px1m">
    <ul class="section-quotes__list">
      {% for item in collections.quotes %}
        <li class="section-quotes__item">
          <div class="flex align-items-center gap2">
            <img src="/img/logos/{{ item.data.logo }}" width="100" alt="{{ item.data.author }} logo" loading="lazy">
            <h3 class="m0">
              {{ item.data.author }}
            </h3>
          </div>
          <div class="mt2">
            {{ item.templateContent | safe }}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
