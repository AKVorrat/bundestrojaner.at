{%- set absolutePageUrl -%}{{ page.url | url }}{%- endset -%}

<link rel="preload" href="/fonts/open-sans-v40-latin-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/open-sans-v40-latin-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/oswald-v53-latin-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/oswald-v53-latin-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/css/page.css" as="style">
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="author" content="{{ site.author }}">
<meta name="robots" content="index,follow">
<meta name="description" content="{{ description or site.description }}">
<title>
  {% if isFront and title %}
    {{ title }}
  {% elseif title %}
    {{ title }} | {{ site.title }}
  {% else %}
    {{ site.title }}
  {% endif %}</title>
<link rel="canonical" href="{{ absolutePageUrl }}">

<link rel="stylesheet" href="/css/page.css">
{% if isFront %}
  <link rel="stylesheet" href="/css/swiper-bundle.min.css">
  <link rel="stylesheet" href="/css/chartist.min.css">
{% endif %}

{# Open Graph #}
<meta property="og:site_name" content="{{ site.author }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description  or site.description }}">
<meta property="og:url" content="{{ absolutePageUrl }}">
<meta name="twitter:card" content="{%- if image -%}summary_large_image{% else %}summary{%- endif -%}">
{%- if image -%}
  <meta property="og:image" content="{{ image | url }}">
{% else %}
  <meta property="og:image" content="{{ site.baseUrl }}/img/splash.png">
{%- endif -%}
